{
  "name": "runlever-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings src vite.config.ts",
    "format": "oxfmt index.html package.json tsconfig.json vite.config.ts src",
    "format:check": "npm run format -- --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
